{
  "name": "axiom-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Axiom - Windows Desktop (no Docker)",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server/server.js",
    "dev": "electron .",
    "dev:web": "node server/server.js",
    "generate-pdf": "node scripts/generate_project_pdf.js",
    "generate-overview-pdf": "node scripts/generate_project_overview_pdf.js",
    "build:win": "electron-builder --win nsis",
    "build:win:msi": "electron-builder --win msi",
    "build:win:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "docx": "^9.5.0",
    "express": "^4.19.2",
    "jszip": "^3.10.1",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.15.0",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^5.0.5",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.axiom.desktop",
    "productName": "Axiom",
    "copyright": "Copyright \u00a9 2026",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "server/**",
      "!server/node_modules/**",
      "web/**",
      "build/**",
      "control_narrative_gen/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "control_narrative_gen/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Axiom"
    }
  }
}