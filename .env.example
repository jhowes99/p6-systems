# P6 Systems — copy to .env and adjust. Do not commit .env.

# --- P6 app (core) ---
P6_HTTP_PORT=3000
NODE_ENV=production
ENABLE_PY=0
# Dev-only bypass. Set to 0 when testing Secure Mode.
HMI_AUTH_BYPASS=1
TELEMETRY_BASE_URL=
# Seed legacy Water Transfer System into canonical model on startup. Set 0 to skip.
P6_SEED_WATER_TRANSFER=1
# Seed Part 13 demo plant (P6 Demo — Tank Transfer System) and bind Runtime to it. Set 0 to skip.
P6_SEED_TANK_TRANSFER=1
# OPC UA server for P6 Connect (Phase 6). Core app still starts if this fails.
ENABLE_OPCUA=1
OPCUA_PORT=4840
# MQTT — enabled by default with core profile (Mosquitto included)
ENABLE_MQTT=1
MQTT_URL=mqtt://mosquitto:1883
MQTT_TOPIC_PREFIX=p6systems
MQTT_PORT=1883
P6_DEFAULT_ROLE=engineer
# Never enable without safety review:
# P6_LIVE_INTEGRATION=0
# ALLOW_BIDIRECTIONAL_TAGS=0

# --- Optional Ignition Gateway (profile: ignition) ---
# Official image pin: inductiveautomation/ignition:8.3.9
ACCEPT_IGNITION_EULA=N
IGNITION_ADMIN_USERNAME=admin
# Set a strong unique password before starting the ignition profile.
IGNITION_ADMIN_PASSWORD=
IGNITION_EDITION=standard
IGNITION_GATEWAY_NAME=P6-Dev-Gateway
IGNITION_GATEWAY_ADDRESS=localhost
IGNITION_HTTP_PORT=9088
IGNITION_HTTPS_PORT=9043
TZ=UTC
